import { Readable } from 'node:stream';
import http from 'node:http';
import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
import { parseAppleHealthExport, aggregateDaily } from './apple-health.js';
import { MeLogIngestClient } from './ingest.js';

const SAMPLE_XML = `<?xml version="1.0" encoding="UTF-8"?>
<HealthData locale="zh_CN">
<ExportDate value="2026-09-04 08:00:00 +0800" />
<Record type="HKCategoryTypeIdentifierSleepAnalysis" sourceName="Watch" value="HKCategoryValueSleepAnalysisAsleepCore" startDate="2026-09-03 05:10:00 +0800" endDate="2026-09-03 06:10:00 +0800" />
<Record type="HKCategoryTypeIdentifierSleepAnalysis" sourceName="Watch" value="HKCategoryValueSleepAnalysisAsleepDeep" startDate="2026-09-03 00:10:00 +0800" endDate="2026-09-03 01:10:00 +0800" />
<Record type="HKQuantityTypeIdentifierStepCount" sourceName="iPhone" unit="count" value="3000" startDate="2026-09-03 08:00:00 +0800" endDate="2026-09-03 09:00:00 +0800" />
<Record type="HKQuantityTypeIdentifierStepCount" sourceName="Watch" unit="count" value="1200" startDate="2026-09-03 12:00:00 +0800" endDate="2026-09-03 12:30:00 +0800" />
<Record type="HKQuantityTypeIdentifierHeartRate" sourceName="Watch" unit="count/min" value="62" startDate="2026-09-03 08:00:00 +0800" endDate="2026-09-03 08:00:00 +0800" />
<Record type="HKQuantityTypeIdentifierHeartRate" sourceName="Watch" unit="count/min" value="70" startDate="2026-09-03 12:00:00 +0800" endDate="2026-09-03 12:00:00 +0800" />
<Record type="HKQuantityTypeIdentifierBodyMass" sourceName="iPhone" unit="kg" value="70.5" startDate="2026-09-02 07:00:00 +0800" endDate="2026-09-02 07:00:00 +0800" />
<Record type="HKQuantityTypeIdentifierBodyMass" sourceName="iPhone" unit="kg" value="70.2" startDate="2026-09-03 07:00:00 +0800" endDate="2026-09-03 07:00:00 +0800" />
<Workout workoutActivityType="HKWorkoutActivityTypeRunning" duration="1800" totalDistance="5000" startDate="2026-09-03 18:00:00 +0800" endDate="2026-09-03 18:30:00 +0800" />
<Record type="HKQuantityTypeIdentifierStepCount" sourceName="iPhone" unit="count" value="999" startDate="2026-08-01 08:00:00 +0800" endDate="2026-08-01 09:00:00 +0800" />
</HealthData>`;

function streamFrom(text: string): Readable {
  return Readable.from([text]);
}

describe('Apple Health 解析', () => {
  it('should stream-parse records and workouts from export.xml', async () => {
    const records = await parseAppleHealthExport(streamFrom(SAMPLE_XML));
    const stepRecords = records.filter((r) => r.type === 'HKQuantityTypeIdentifierStepCount');
    expect(stepRecords).toHaveLength(3);
    const workout = records.find((r) => r.kind === 'workout');
    expect(workout?.workoutActivityType).toBe('HKWorkoutActivityTypeRunning');
    expect(workout?.duration).toBe('1800');
  });

  it('should aggregate daily entries within the window', async () => {
    const records = await parseAppleHealthExport(streamFrom(SAMPLE_XML));
    const entries = aggregateDaily(records, { days: 30, until: new Date('2026-09-04T23:59:59+08:00') });

    const sleep = entries.find((e) => e.type === 'sleep' && e.externalId === 'ah-sleep-2026-09-03');
    expect(sleep).toBeDefined();
    expect(JSON.parse(sleep!.payload!)).toEqual({
      value: 2,
      unit: 'hours',
      sleepStages: { AsleepCore: 1, AsleepDeep: 1 },
    });

    const steps = entries.find((e) => e.type === 'steps');
    expect(JSON.parse(steps!.payload!).value).toBe(4200);

    const heartRate = entries.find((e) => e.type === 'heart-rate');
    expect(JSON.parse(heartRate!.payload!).value).toBe(66);

    const weight = entries.find((e) => e.externalId === 'ah-weight-2026-09-03');
    expect(JSON.parse(weight!.payload!).value).toBe(70.2);

    const exercise = entries.find((e) => e.type === 'exercise');
    expect(exercise!.title).toContain('Running');
    expect(JSON.parse(exercise!.payload!)).toMatchObject({ value: 30, unit: 'minutes' });

    // 8 月的记录超出 30 天窗口，不出现
    expect(entries.find((e) => e.externalId === 'ah-steps-2026-08-01')).toBeUndefined();
  });
});

describe('MeLog Ingest 客户端', () => {
  let server: http.Server;
  let port = 0;
  let seen: { url: string; auth: string; body: { source?: { adapter?: string }; entries?: unknown[] } };

  beforeAll(async () => {
    server = http.createServer((req, res) => {
      let body = '';
      req.on('data', (chunk) => (body += chunk));
      req.on('end', () => {
        seen.url = req.url || '';
        seen.auth = req.headers.authorization || '';
        seen.body = JSON.parse(body || '{}');
        res.setHeader('Content-Type', 'application/json');
        res.end(JSON.stringify({ sourceId: 'src-1', created: 1, updated: 0, skipped: 0 }));
      });
    });
    await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
    port = (server.address() as { port: number }).port;
  });

  afterAll(
    () =>
      new Promise<void>((resolve) => {
        if (server) server.close(() => resolve());
        else resolve();
      }),
  );

  beforeEach(() => {
    seen = { url: '', auth: '', body: {} };
  });

  it('should post entries to the ingest API with auth header', async () => {
    const client = new MeLogIngestClient({ apiUrl: `http://127.0.0.1:${port}`, token: 'test-token' });

    const entries = Array.from({ length: 3 }, (_, i) => ({
      externalId: `e-${i}`,
      category: 'im' as const,
      type: 'chat-message',
      title: `消息 ${i}`,
      occurredAt: new Date('2026-09-03T10:00:00Z'),
    }));

    const result = await client.ingest('chatlog', '微信聊天记录', 'im', entries);
    expect(result.created).toBe(3);
    expect(seen.auth).toBe('Bearer test-token');
    expect(seen.url).toBe('/api/melog/ingest');
    expect(seen.body.source?.adapter).toBe('chatlog');
    expect(seen.body.entries).toHaveLength(3);
  });

  it('should reject non-http api urls', () => {
    expect(() => new MeLogIngestClient({ apiUrl: 'ftp://example.com' })).toThrow(/http/);
  });
});
